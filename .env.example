# 复制为 .env 并填入真实值（.env 已被 gitignore）
TURSO_URL=libsql://<org>-<db>.turso.io
TURSO_AUTH_TOKEN=

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLED=true

REMINDER_TO=

# 腾讯云 OCR（用于客户证照自动识别，密钥来自 k.txt）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
